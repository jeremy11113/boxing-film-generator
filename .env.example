# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Video Generation API (Runway ML)
RUNWAY_API_KEY=your_runway_api_key_here

# Alternative Video APIs
PIKA_API_KEY=your_pika_api_key_here
ELEN_API_KEY=your_elen_api_key_here

# Output Configuration
OUTPUT_DIR=./output
VIDEO_QUALITY=high
FRAMERATE=30

# Generation Settings
MAX_SCENES=15
SCREENPLAY_LENGTH=medium
